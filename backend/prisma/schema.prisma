// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING     // pedido criado, aguardando pagamento
  PAID        // pagamento confirmado
  SHIPPED     // enviado
  DELIVERED   // entregue
  CANCELED    // cancelado
}

enum CategoryType {
  CATEGORIA // ex: Corrida, Basquete, Skate, Lifestyle
  GENERO    // ex: Masculino, Feminino, Unissex
}

// ============================================
// USERS
// ============================================

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders    Order[]
  cartItems CartItem[]

  @@map("users")
}

// ============================================
// BRANDS
// ============================================

model Brand {
  id      Int     @id @default(autoincrement())
  nome    String  @unique
  logoUrl String? @map("logo_url")

  products Product[]

  @@map("brands")
}

// ============================================
// CATEGORIES
// ============================================

model Category {
  id   Int          @id @default(autoincrement())
  nome String
  tipo CategoryType

  products Product[]

  @@unique([nome, tipo])
  @@map("categories")
}

// ============================================
// PRODUCTS
// ============================================

model Product {
  id              Int      @id @default(autoincrement())
  nome            String
  descricao       String?
  precoBase       Decimal  @map("preco_base") @db.Decimal(10, 2)
  imagemPrincipal String?  @map("imagem_principal")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  brandId Int   @map("brand_id")
  brand   Brand @relation(fields: [brandId], references: [id])

  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]
  images   ProductImage[]

  @@index([brandId])
  @@index([categoryId])
  @@map("products")
}

// ============================================
// PRODUCT VARIANTS (tamanho/cor + estoque)
// ============================================

model ProductVariant {
  id      Int    @id @default(autoincrement())
  tamanho Int
  cor     String
  estoque Int    @default(0)
  sku     String @unique

  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, tamanho, cor])
  @@index([productId])
  @@map("product_variants")
}

// ============================================
// PRODUCT IMAGES (galeria)
// ============================================

model ProductImage {
  id    Int    @id @default(autoincrement())
  url   String
  ordem Int    @default(0)

  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ============================================
// ORDERS
// ============================================

model Order {
  id       Int         @id @default(autoincrement())
  status   OrderStatus @default(PENDING)
  total    Decimal     @db.Decimal(10, 2)
  criadoEm DateTime    @default(now()) @map("criado_em")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  items OrderItem[]

  @@index([userId])
  @@map("orders")
}

// ============================================
// ORDER ITEMS
// ============================================

model OrderItem {
  id            Int     @id @default(autoincrement())
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)

  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId Int            @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// ============================================
// CART ITEMS
// ============================================

model CartItem {
  id         Int @id @default(autoincrement())
  quantidade Int @default(1)

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  variantId Int            @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId])
  @@map("cart_items")
}