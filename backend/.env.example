# Conexão com o PostgreSQL (ex: Supabase). DIRECT_URL é usada pelas migrations.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"
DIRECT_URL="postgresql://usuario:senha@host:5432/banco"

# Segredo usado pra assinar os tokens JWT — use um valor longo e aleatório
JWT_SECRET="troque-por-um-segredo-grande"

# Porta da API (opcional, padrão 3333)
PORT=3333

# URL do frontend publicado, liberada no CORS (opcional em dev)
FRONTEND_URL=
